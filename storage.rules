rules_version = '2';

// قواعد أمان Firebase Storage لتطبيق "سند"
// انسخ هذا الملف بالكامل إلى:
// Firebase Console > Storage > Rules

service firebase.storage {
  match /b/{bucket}/o {

    // معرض أعمال الحرفي / المنشورات - صور وفيديوهات لملف المستخدم
    match /portfolio/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // منشورات الرئيسية الشاملة (Posts / Reels)
    match /posts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // الصور الشخصية
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024;
    }

    // وسائط المحادثات - المشاركون فقط يكتبون/يقرأون
    match /chatMedia/{chatId}/{fileName} {
      allow read: if request.auth != null
                    && request.auth.uid in chatId.split("_");
      allow write: if request.auth != null
                    && request.auth.uid in chatId.split("_")
                    && request.resource.size < 50 * 1024 * 1024;
      allow delete: if request.auth != null
                    && request.auth.uid in chatId.split("_");
    }

    // وسائط المنتجات — صور وفيديوهات
    match /products/{productId}/{fileName=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null;
    }

    // وسائط القصص — صور وفيديوهات stories
    match /stories/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // منشورات الملف الشخصي
    match /profile-posts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // إيصالات تحويل المحفظة
    match /walletReceipts/{userId}/{fileName} {
      allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == "JBtQBKkpMvOT58abx2wZqOtxNwU2");
      allow write: if request.auth != null
                    && request.auth.uid == userId;
    }
  }
}

