# ── Port ─────────────────────────────────────────────────────────────────────
PORT=3001

# ── Firebase Admin ────────────────────────────────────────────────────────────
# Option A (recommended): path to your downloaded service-account JSON file
GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Option B: paste the entire JSON as a single-line string (escape quotes)
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"mandobek-al-saree",...}

# ── Firebase project ──────────────────────────────────────────────────────────
FIREBASE_PROJECT_ID=mandobek-al-saree

# ── WhatsApp sender number (international format, no +) ───────────────────────
# This is the number whose WhatsApp will be opened for QR scanning
WA_SENDER=9647827263200
