rules_version = '2';

// قواعد أمان Firebase Storage لتطبيق "سند"
// انسخ هذا الملف بالكامل إلى:
// Firebase Console > Storage > Rules

service firebase.storage {
  match /b/{bucket}/o {

    // معرض أعمال الحرفي / المنشورات - صور وفيديوهات لملف المستخدم
    match /portfolio/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // منشورات الرئيسية الشاملة (Posts / Reels)
    match /posts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // الصور الشخصية
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 10 * 1024 * 1024;
    }

    // وسائط المحادثات - أي مشارك حالي يستطيع إرسال/قراءة الوسائط.
    // هذا يعتمد على participants من وثيقة المحادثة، لذلك الأعضاء المضافون
    // لاحقاً إلى المجموعة يستطيعون أيضاً إرسال الصور والفيديو.
    match /chatMedia/{chatId}/{fileName} {
      function isChatParticipant() {
        return request.auth != null
          && request.auth.uid in firestore.get(/databases/(default)/documents/chats/$(chatId)).data.participants;
      }
      allow read: if isChatParticipant();
      allow write: if isChatParticipant()
                    && request.resource.size < 50 * 1024 * 1024;
      allow delete: if isChatParticipant();
    }

    // وسائط المنتجات — صور وفيديوهات
    match /products/{productId}/{fileName=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null;
    }

    // وسائط القصص — صور وفيديوهات stories
    match /stories/{userId}/{allPaths=**} {
      allow read:  if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }

    // منشورات الملف الشخصي
    match /profile-posts/{userId}/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.auth.uid == userId
                    && request.resource.size < 100 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*|video/.*');
      allow delete: if request.auth != null
                    && request.auth.uid == userId;
    }



    // صور أغلفة مجموعات المحادثة
    match /chatGroups/{chatId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
                    && request.resource.size < 10 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null;
    }

    // إيصالات تحويل المحفظة
    match /walletReceipts/{userId}/{fileName} {
      allow read: if request.auth != null
                    && (request.auth.uid == userId
                        || request.auth.uid == "JBtQBKkpMvOT58abx2wZqOtxNwU2");
      allow write: if request.auth != null
                    && request.auth.uid == userId;
    }
  }
}

