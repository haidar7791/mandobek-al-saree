rules_version = '2';

// قواعد أمان Firestore لتطبيق "سند"
// انسخ هذا الملف بالكامل إلى:
// Firebase Console > Firestore Database > Rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "JBtQBKkpMvOT58abx2wZqOtxNwU2";
    }

    // ── المستخدمون ──
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }

    // ── الحرفيون (يجب أن تكون قابلة للقراءة من جميع المسجلين) ──
    match /artisans/{artisanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();

      // ── التقييمات (subcollection — معرف المستند: clientId_artisanId لمنع التكرار) ──
      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.clientId == request.auth.uid
                      && reviewId == request.resource.data.clientId + "_" + request.resource.data.artisanId;
        allow update: if isSignedIn()
                      && resource.data.clientId == request.auth.uid
                      && request.resource.data.clientId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // ── التقييمات (نمط قديم — يُبقى للتوافق الرجعي إن وُجدت مستندات سابقة) ──
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── طلبات الخدمة ──
    // ملاحظة: artisanId هو معرّف مستند الحرفي في مجموعة artisans (وليس uid الخاص بالمصادقة).
    // معرّف المصادقة (auth.uid) الخاص بالحرفي مخزّن في حقل artisanUserId — يجب دائماً
    // مقارنة request.auth.uid بـ artisanUserId، وليس بـ artisanId.
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn() && (
                    resource.data.clientId == request.auth.uid
                    || resource.data.artisanUserId == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isSignedIn()
                    && request.resource.data.clientId == request.auth.uid;
      allow update: if isSignedIn() && (
                      resource.data.clientId == request.auth.uid
                      || resource.data.artisanUserId == request.auth.uid
                      || isAdmin()
                    );
      allow delete: if isAdmin();
    }

    // ── المحادثات ──
    match /chats/{chatId} {
      allow read, write: if isSignedIn()
                          && request.auth.uid in chatId.split("_");

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in chatId.split("_");
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in chatId.split("_");
        allow update: if isSignedIn()
                      && request.auth.uid in chatId.split("_")
                      && resource.data.senderId != request.auth.uid
                      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]);
      }
    }

    // ── المحفظة ──
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── طلبات المحفظة ──
    match /walletRequests/{requestId} {
      allow read: if isSignedIn() && (
                    resource.data.userId == request.auth.uid || isAdmin()
                  );
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
  }
}
