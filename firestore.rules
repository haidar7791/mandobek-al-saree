rules_version = '2';

// قواعد أمان Firestore لتطبيق "فورس"
// انسخ هذا الملف بالكامل إلى:
// Firebase Console > Firestore Database > Rules

service cloud.firestore {
  match /databases/{database}/documents {

    // ============================================================
    // Helpers
    // ============================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "JBtQBKkpMvOT58abx2wZqOtxNwU2";
    }

    function chatAllowsMessage(chatId) {
      let chat = get(
        /databases/$(database)/documents/chats/$(chatId)
      ).data;

      return isSignedIn()
        && request.auth.uid in chat.participants
        && (
          chat.isGroup == true
          ||
          (
            request.auth.uid == chat.participants[0]
            && !(
              request.auth.uid in
              get(
                /databases/$(database)/documents/users/$(chat.participants[1])
              ).data.get("blockedUserIds", [])
            )
          )
          ||
          (
            request.auth.uid == chat.participants[1]
            && !(
              request.auth.uid in
              get(
                /databases/$(database)/documents/users/$(chat.participants[0])
              ).data.get("blockedUserIds", [])
            )
          )
        );
    }

    // Like transactions update an owner's aggregate counter even when the
    // authenticated user is a different account from the content owner.
    // Keep this exception limited to the counter fields used by the app.
    function canUpdateContentLikeCounter() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["contentLikesCount"])
        && request.resource.data.get("contentLikesCount", -1) is number
        && request.resource.data.get("contentLikesCount", -1) >= 0;
    }

    // Profile-post likes also update the denormalized profilePosts array to
    // keep that post's likesCount in sync with its likes subcollection.
    function canUpdateProfilePostLikeCounters() {
      return isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(["profilePosts", "contentLikesCount"])
        && request.resource.data.get("contentLikesCount", -1) is number
        && request.resource.data.get("contentLikesCount", -1) >= 0;
    }

    // ============================================================
    // Followers collection group
    // مطلوب لـ getFollowingProfiles()
    // ============================================================

    match /{path=**}/followers/{followerId} {
      allow read: if isSignedIn();
    }

    // ============================================================
    // المنشورات الرئيسية والمعرض
    // Posts / Reels Feed
    // ============================================================

    match /posts/{postId} {

      allow read, write: if isSignedIn();

      // إعجابات المنشور: كل مستخدم يدير مستند إعجابه فقط.
      match /likes/{likerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == likerId
          && request.resource.data.keys().hasOnly([
            "userId",
            "createdAt",
            "likedAt",
            "likerId"
          ]);
        allow delete: if isSignedIn()
          && request.auth.uid == likerId;
        allow update: if false;
      }

      // تعليقات المنشور
      match /comments/{commentId} {

        allow read, write: if isSignedIn();

        // إعجابات التعليق
        // مطلوب لـ togglePostCommentLike()
        // و getPostComments()
        match /likes/{likerId} {
          allow read: if isSignedIn();

          allow create: if isSignedIn()
            && request.auth.uid == likerId;

          allow delete: if isSignedIn()
            && request.auth.uid == likerId;

          allow update: if false;
        }
      }
    }

    // ============================================================
    // منشورات الملف الشخصي ومعرض الأعمال
    // Profile Posts
    // ============================================================

    match /profilePosts/{postId} {

      allow read, write: if isSignedIn();

      match /likes/{likerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == likerId
          && request.resource.data.keys().hasOnly([
            "likedAt",
            "likerId",
            "userId",
            "createdAt"
          ]);
        allow delete: if isSignedIn()
          && request.auth.uid == likerId;
        allow update: if false;
      }

      match /comments/{commentId} {

        allow read, write: if isSignedIn();

        // إعجابات تعليقات منشورات الملف الشخصي
        match /likes/{likerId} {
          allow read: if isSignedIn();

          allow create: if isSignedIn()
            && request.auth.uid == likerId;

          allow delete: if isSignedIn()
            && request.auth.uid == likerId;

          allow update: if false;
        }
      }
    }

    // ============================================================
    // المستخدمون والملف الشخصي
    // ============================================================

    match /users/{userId} {

      // الملف الشخصي قابل للقراءة للمستخدمين المسجلين، لكن حالة الحظر
      // وحقول الإدارة لا يمكن تعديلها إلا من قبل المسؤول.
      allow read: if isSignedIn();

      allow create: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && request.resource.data.get("isBanned", false) == false
          && request.resource.data.get("role", "client") in ["client", "artisan"]
        );

      allow update: if isAdmin()
        || (
          isSignedIn()
          && request.auth.uid == userId
          && resource.data.get("isBanned", false) != true
          && request.resource.data.diff(resource.data).affectedKeys().hasAny([
            "isBanned",
            "bannedAt",
            "bannedBy",
            "banReason",
            "role"
          ]) == false
        )
        || canUpdateContentLikeCounter()
        || canUpdateProfilePostLikeCounters();

      allow delete: if isAdmin();

      // المتابعون
      match /followers/{followerId} {

        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.auth.uid == followerId
          && exists(
            /databases/$(database)/documents/users/$(userId)
          )
          && request.resource.data.keys().hasOnly([
            "followedAt"
          ]);

        allow delete: if isSignedIn()
          && request.auth.uid == followerId;

        allow update: if false;
      }

      // إعجابات الملف الشخصي
      match /likes/{likerId} {

        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.auth.uid == likerId
          && exists(
            /databases/$(database)/documents/users/$(userId)
          )
          && request.resource.data.keys().hasOnly([
            "likedAt",
            "likerId"
          ]);

        allow delete: if isSignedIn()
          && request.auth.uid == likerId;

        allow update: if false;
      }

      // التقييمات
      match /reviews/{reviewId} {
        allow read, write: if isSignedIn();
      }

      // إعجابات منشورات الملف الشخصي الموجودة داخل users
      match /profilePosts/{postId}/likes/{likerId} {

        allow read: if isSignedIn();

        allow create: if isSignedIn()
          && request.auth.uid == likerId
          && request.resource.data.keys().hasOnly([
            "likedAt",
            "likerId"
          ]);

        allow delete: if isSignedIn()
          && request.auth.uid == likerId;

        allow update: if false;
      }
    }

    // ============================================================
    // فهرس الهاتف
    // ============================================================

    match /phoneIndex/{phone} {

      allow get: if true;

      allow list: if false;

      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly([
          "phone",
          "userId"
        ])
        && request.resource.data.phone == phone;

      allow delete: if isAdmin();
    }

    // ============================================================
    // الإشعارات
    // ============================================================

    match /notifications/{notificationId} {

      // المستخدم يستطيع قراءة إشعاراته فقط
      allow read: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;

      // إنشاء إشعار باسم المستخدم الحالي فقط
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && (
          request.resource.data.recipientId != request.auth.uid
          || request.resource.data.type == "moderation"
        );

      allow update: if isSignedIn()
        && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == request.auth.uid;

      allow delete: if isSignedIn()
        && resource.data.recipientId == request.auth.uid;
    }

    // ============================================================
    // الحرفيون والبائعون
    // ============================================================

    match /artisans/{artisanId} {

      allow read, write: if isSignedIn();

      match /reviews/{reviewId} {
        allow read, write: if isSignedIn();
      }
    }

    // ============================================================
    // المحفظة
    // ============================================================

    match /wallets/{userId} {
      allow read, write: if isSignedIn();
    }

    // ============================================================
    // طلبات المحفظة
    // ============================================================

    match /walletRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // ============================================================
    // سجلات الترويج
    // ============================================================

    match /promotions/{promoId} {
      allow read, write: if isSignedIn();
    }

    // ============================================================
    // المنتجات
    // ============================================================

    match /products/{productId} {

      allow read, write: if isSignedIn();

      match /likes/{likerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == likerId
          && request.resource.data.keys().hasOnly([
            "likedAt",
            "likerId",
            "userId",
            "createdAt"
          ]);
        allow delete: if isSignedIn()
          && request.auth.uid == likerId;
        allow update: if false;
      }

      match /comments/{commentId} {
        allow read, write: if isSignedIn();
      }
    }

    // ============================================================
    // القصص
    // ============================================================

    match /stories/{storyId} {
      allow read, write: if isSignedIn();
    }

    // ============================================================
    // طلبات الخدمة
    // ============================================================

    match /serviceRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // ============================================================
    // المحادثات والرسائل
    // ============================================================

    match /chats/{chatId} {

      allow read, write: if isSignedIn();

      match /messages/{messageId} {

        allow read: if isSignedIn();

        allow create: if chatAllowsMessage(chatId);

        allow update, delete: if isSignedIn();
      }
    }

    // ============================================================
    // طلبات شراء المنتجات
    // ============================================================

    match /productOrders/{orderId} {
      allow read, write: if isSignedIn();
    }

    // ============================================================
    // المتابعات والتقييمات
    // ============================================================

    match /follows/{followId} {
      allow read, write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read, write: if isSignedIn();
    }

    match /ratings/{ratingId} {
      allow read, write: if isSignedIn();
    }

    // بلاغات المحتوى — المستخدم يرسل البلاغ فقط، والمسؤولون يراجعونه.
    match /reports/{reportId} {
      allow create: if isSignedIn()
        && request.resource.data.reporterId == request.auth.uid
        && request.resource.data.reporterName is string
        && request.resource.data.targetId is string
        && request.resource.data.targetType in ["product", "post", "story", "chat"]
        && request.resource.data.reason in [
          "inappropriate",
          "violence",
          "child_exploitation",
          "harassment",
          "spam_scam",
          "other"
        ]
        && request.resource.data.status == "open";
      allow read, update, delete: if isAdmin();
    }
  }
}
