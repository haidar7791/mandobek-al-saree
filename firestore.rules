rules_version = '2';

// قواعد أمان Firestore لتطبيق "فورس"
// انسخ هذا الملف بالكامل إلى:
// Firebase Console > Firestore Database > Rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "JBtQBKkpMvOT58abx2wZqOtxNwU2";
    }

    // ── المنشورات الرئيسية والمعرض (Posts / Reels Feed) ──────────────────────────
    // دعم جلب وإنشاء منشورات الرئيسية مع الإعجابات والتعليقات
    match /posts/{postId} {
      allow read, write: if isSignedIn();

      match /likes/{likerId} {
        allow read, write: if isSignedIn();
      }

      match /comments/{commentId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── منشورات الملف الشخصي ومعرض الأعمال (Profile Posts) ──────────────────────
    match /profilePosts/{postId} {
      allow read, write: if isSignedIn();

      match /likes/{likerId} {
        allow read, write: if isSignedIn();
      }

      match /comments/{commentId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── المستخدمون والملف الشخصي ─────────────────────────────────────────────
    match /users/{userId} {
      allow read, write: if isSignedIn();

      match /followers/{followerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == followerId
          && exists(/databases/$(database)/documents/users/$(userId))
          && request.resource.data.keys().hasOnly(["followedAt"]);
        allow delete: if isSignedIn() && request.auth.uid == followerId;
        allow update: if false;
      }

      match /likes/{likerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == likerId
          && exists(/databases/$(database)/documents/users/$(userId))
          && request.resource.data.keys().hasOnly(["likedAt"]);
        allow delete: if isSignedIn() && request.auth.uid == likerId;
        allow update: if false;
      }

      match /reviews/{reviewId} {
        allow read, write: if isSignedIn();
      }

      match /profilePosts/{postId}/likes/{likerId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
          && request.auth.uid == likerId
          && request.resource.data.keys().hasOnly(["likedAt", "likerId"]);
        allow delete: if isSignedIn() && request.auth.uid == likerId;
        allow update: if false;
      }
    }

    // فحص وجود الهاتف
    match /phoneIndex/{phone} {
      allow get: if true;
      allow list: if false;
      allow create, update: if isSignedIn()
        && request.resource.data.keys().hasOnly(["phone", "userId"])
        && request.resource.data.phone == phone;
      allow delete: if isAdmin();
    }

    // Activity notifications are private to their recipient. A signed-in
    // client may create only an activity attributed to its own account.
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && resource.data.recipientId == request.auth.uid;
      allow create: if isSignedIn()
        && request.resource.data.actorId == request.auth.uid
        && request.resource.data.recipientId != request.auth.uid;
      allow update: if isSignedIn() && resource.data.recipientId == request.auth.uid
        && request.resource.data.recipientId == request.auth.uid;
      allow delete: if isSignedIn() && resource.data.recipientId == request.auth.uid;
    }

    // ── الحرفيون والبائعون ───────────────────────────────────────────────────
    match /artisans/{artisanId} {
      allow read, write: if isSignedIn();

      match /reviews/{reviewId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── المحفظة ──────────────────────────────────────────────────────────────
    match /wallets/{userId} {
      allow read, write: if isSignedIn();
    }

    // ── طلبات المحفظة ────────────────────────────────────────────────────────
    match /walletRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // ── سجلات الترويج ────────────────────────────────────────────────────────
    match /promotions/{promoId} {
      allow read, write: if isSignedIn();
    }

    // ── المنتجات ─────────────────────────────────────────────────────────────
    match /products/{productId} {
      allow read, write: if isSignedIn();

      match /likes/{likerId} {
        allow read, write: if isSignedIn();
      }

      match /comments/{commentId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── القصص (Stories) ──────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read, write: if isSignedIn();
    }

    // ── طلبات الخدمة ─────────────────────────────────────────────────────────
    match /serviceRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // ── المحادثات والرسائل ────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── طلبات شراء المنتجات ───────────────────────────────────────────────────
    match /productOrders/{orderId} {
      allow read, write: if isSignedIn();
    }

    // ── المتابعات والتقييمات ──────────────────────────────────────────────────
    match /follows/{followId} {
      allow read, write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read, write: if isSignedIn();
    }

    match /ratings/{ratingId} {
      allow read, write: if isSignedIn();
    }

  }
}

