rules_version = '2';

// قواعد أمان Firestore لتطبيق "فورس"
// انسخ هذا الملف بالكامل إلى:
// Firebase Console > Firestore Database > Rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "JBtQBKkpMvOT58abx2wZqOtxNwU2";
    }

    // ── المستخدمون والملف الشخصي ─────────────────────────────────────────────
    // أي مستخدم مسجّل يقرأ ويكتب (مطلوب للترويج وتحديث البيانات الشخصية)
    match /users/{userId} {
      allow read, write: if isSignedIn();
    }

    // ── الحرفيون والبائعون ───────────────────────────────────────────────────
    // أي مستخدم مسجّل يقرأ ويكتب (مطلوب لتحديث isPromoted وpriorityScore)
    match /artisans/{artisanId} {
      allow read, write: if isSignedIn();

      match /reviews/{reviewId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── المحفظة ──────────────────────────────────────────────────────────────
    // مطلوب: المستخدم يخصم من رصيده أثناء الترويج
    match /wallets/{userId} {
      allow read, write: if isSignedIn();
    }

    // ── طلبات المحفظة ────────────────────────────────────────────────────────
    match /walletRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // ── سجلات الترويج ────────────────────────────────────────────────────────
    match /promotions/{promoId} {
      allow read, write: if isSignedIn();
    }

    // ── المنتجات ─────────────────────────────────────────────────────────────
    // أي مستخدم مسجّل يقرأ ويكتب (مطلوب لتحديث priorityScore بالجملة)
    match /products/{productId} {
      allow read, write: if isSignedIn();
    }

    // ── القصص (Stories) ──────────────────────────────────────────────────────
    match /stories/{storyId} {
      allow read, write: if isSignedIn();
    }

    // ── طلبات الخدمة ─────────────────────────────────────────────────────────
    match /serviceRequests/{requestId} {
      allow read, write: if isSignedIn();
    }

    // ── المحادثات والرسائل ────────────────────────────────────────────────────
    match /chats/{chatId} {
      allow read, write: if isSignedIn();

      match /messages/{messageId} {
        allow read, write: if isSignedIn();
      }
    }

    // ── طلبات شراء المنتجات ───────────────────────────────────────────────────
    match /productOrders/{orderId} {
      allow read, write: if isSignedIn();
    }

    // ── المتابعات والتقييمات ──────────────────────────────────────────────────
    match /follows/{followId} {
      allow read, write: if isSignedIn();
    }

    match /reviews/{reviewId} {
      allow read, write: if isSignedIn();
    }

    match /ratings/{ratingId} {
      allow read, write: if isSignedIn();
    }

    // ── Catch-all: أي مجموعة أخرى غير مذكورة ─────────────────────────────────
    match /{document=**} {
      allow read, write: if isSignedIn();
    }
  }
}
