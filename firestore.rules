rules_version = '2';

// قواعد أمان Firestore لتطبيق "سند"
// انسخ هذا الملف بالكامل إلى:
// Firebase Console > Firestore Database > Rules

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isAdmin() {
      return isSignedIn()
        && request.auth.uid == "JBtQBKkpMvOT58abx2wZqOtxNwU2";
    }

    // ── المستخدمون ──
    // القراءة: أي مستخدم مسجّل (لعرض الملفات الشخصية)
    // الكتابة: صاحب الحساب نفسه أو المشرف (يشمل create/update/delete)
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isOwner(userId) || isAdmin();
    }

    // ── سجلات الترويج ──────────────────────────────────────────────────────────
    // أي مستخدم مسجّل يمكنه قراءة وكتابة سجلات الترويج (للدفع والتفعيل)
    match /promotions/{promoId} {
      allow read, write: if isSignedIn();
    }

    // ── الحرفيون (يجب أن تكون قابلة للقراءة من جميع المسجلين) ──
    match /artisans/{artisanId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn()
                    && resource.data.userId == request.auth.uid;
      allow delete: if isAdmin();

      // ── التقييمات (subcollection — معرف المستند: clientId_artisanId لمنع التكرار) ──
      match /reviews/{reviewId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn()
                      && request.resource.data.clientId == request.auth.uid
                      && reviewId == request.resource.data.clientId + "_" + request.resource.data.artisanId;
        allow update: if isSignedIn()
                      && resource.data.clientId == request.auth.uid
                      && request.resource.data.clientId == request.auth.uid;
        allow delete: if isAdmin();
      }
    }

    // ── التقييمات (نمط قديم — يُبقى للتوافق الرجعي إن وُجدت مستندات سابقة) ──
    match /reviews/{reviewId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.clientId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── طلبات الخدمة ──
    // ملاحظة: artisanId هو معرّف مستند الحرفي في مجموعة artisans (وليس uid الخاص بالمصادقة).
    // معرّف المصادقة (auth.uid) الخاص بالحرفي مخزّن في حقل artisanUserId — يجب دائماً
    // مقارنة request.auth.uid بـ artisanUserId، وليس بـ artisanId.
    match /serviceRequests/{requestId} {
      allow read: if isSignedIn() && (
                    resource.data.clientId == request.auth.uid
                    || resource.data.artisanUserId == request.auth.uid
                    || isAdmin()
                  );
      allow create: if isSignedIn()
                    && request.resource.data.clientId == request.auth.uid;
      allow update: if isSignedIn() && (
                      resource.data.clientId == request.auth.uid
                      || resource.data.artisanUserId == request.auth.uid
                      || isAdmin()
                    );
      allow delete: if isAdmin();
    }

    // ── المحادثات ──
    match /chats/{chatId} {
      allow read, write: if isSignedIn()
                          && request.auth.uid in chatId.split("_");

      match /messages/{messageId} {
        allow read: if isSignedIn()
                    && request.auth.uid in chatId.split("_");
        allow create: if isSignedIn()
                      && request.resource.data.senderId == request.auth.uid
                      && request.auth.uid in chatId.split("_");
        allow update: if isSignedIn()
                      && request.auth.uid in chatId.split("_")
                      && (
                        (resource.data.senderId != request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["read"]))
                        || (resource.data.senderId == request.auth.uid
                          // "Delete for everyone" only: the sender may replace their own
                          // message with the fixed placeholder, not edit arbitrary content.
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["deleted", "text", "type", "mediaUrl", "duration"])
                          && request.resource.data.deleted == true
                          && request.resource.data.type == "text"
                          && request.resource.data.text == "تم حذف هذه الرسالة"
                          && !("mediaUrl" in request.resource.data)
                          && !("duration" in request.resource.data))
                      );
      }
    }

    // ── المحفظة ──
    match /wallets/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow write: if isAdmin();
    }

    // ── طلبات المحفظة ──
    match /walletRequests/{requestId} {
      allow read: if isSignedIn() && (
                    resource.data.userId == request.auth.uid || isAdmin()
                  );
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // ── المنتجات (سوق البيع والشراء) ──
    match /products/{productId} {
      // أي مستخدم مسجّل يمكنه استعراض المنتجات
      allow read: if isSignedIn();
      // الإنشاء مسموح فقط إن كان sellerId هو المستخدم الحالي
      allow create: if isSignedIn()
                    && request.resource.data.sellerId == request.auth.uid;
      // التعديل مسموح للبائع أو المشرف
      // (respondToProductOrder تُحدّث status من "available" → "sold")
      allow update: if isSignedIn() && (
                      resource.data.sellerId == request.auth.uid
                      || isAdmin()
                    );
      allow delete: if isSignedIn() && resource.data.sellerId == request.auth.uid
                    || isAdmin();
    }

    // ── القصص (Stories) ──────────────────────────────────────────────────────
    // أي مستخدم مسجّل يقرأ / ينشئ / يحدّث (مشاهدة، إعجاب، نص).
    // الحذف محصور على صاحب القصة أو المشرف.
    match /stories/{storyId} {
      allow read:   if isSignedIn();
      allow create: if isSignedIn()
                    && request.resource.data.userId == request.auth.uid;
      allow update: if isSignedIn();          // views/likes arrayUnion من أي مستخدم
      allow delete: if isSignedIn()
                    && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ── المتابعات ─────────────────────────────────────────────────────────────
    match /follows/{followId} {
      allow read:          if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete:        if isSignedIn();
    }

    // ── التقييمات العامة (مجموعة مستقلة) ────────────────────────────────────
    match /ratings/{ratingId} {
      allow read:          if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete:        if isAdmin();
    }

    // ── طلبات شراء المنتجات ──
    match /productOrders/{orderId} {
      // البائع أو المشتري أو المشرف يمكنهم القراءة
      allow read: if isSignedIn() && (
                    resource.data.sellerId == request.auth.uid
                    || resource.data.buyerId == request.auth.uid
                    || isAdmin()
                  );
      // المشتري فقط ينشئ الطلب
      allow create: if isSignedIn()
                    && request.resource.data.buyerId == request.auth.uid;
      // البائع أو المشرف يُعدّل الحالة (قبول / رفض)
      // المشتري يعدّل حقل hiddenForBuyer فقط (إخفاء ناعم بدلاً من الحذف)
      allow update: if isSignedIn() && (
                      resource.data.sellerId == request.auth.uid
                      || (resource.data.buyerId == request.auth.uid
                          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["hiddenForBuyer"]))
                      || isAdmin()
                    );
      // المشتري يحذف طلبه المعلق فقط (إلغاء)؛ المشرف يحذف أي طلب
      allow delete: if isSignedIn() && (
                      (resource.data.buyerId == request.auth.uid
                        && resource.data.status == "pending")
                      || isAdmin()
                    );
    }
  }
}
